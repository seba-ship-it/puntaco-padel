rules_version = '2';

// La liga (tabla, fechas, perfiles) la puede leer cualquiera con el link.
// Escribirla, y ver o tocar los pagos, solo la cuenta compartida de quien carga.
service cloud.firestore {
  match /databases/{database}/documents {
    function esEncargado() {
      return request.auth != null
        && request.auth.token.email == 'seba@agenciazeta.com';
    }

    match /league/{doc} {
      allow read: if true;
      allow write: if esEncargado();
    }

    match /finance/{doc} {
      allow read, write: if esEncargado();
    }

    // Jornada abierta: el link secreto es el id del documento. Quien lo tiene
    // puede leerla y cargar marcadores (solo el campo `matches`) mientras esté
    // abierta. Listarlas, abrirlas, cerrarlas y borrarlas es solo del encargado.
    match /jornadas/{token} {
      allow get: if true;
      allow list, create, delete: if esEncargado();
      allow update: if esEncargado()
        || (resource.data.status == 'open'
            && request.resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matches', 'updatedAt']));
    }
  }
}
