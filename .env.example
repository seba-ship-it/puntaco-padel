# Copiá este archivo a ".env" y completá con los datos de tu app web de Firebase
# (Configuración del proyecto → Tus apps). Son identificadores públicos, no
# secretos, pero igual se cargan como "secrets" en GitHub Actions para la build.

VITE_FIREBASE_API_KEY=tu-api-key
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Email de la cuenta compartida de quien carga (debe coincidir con firestore.rules).
VITE_ADMIN_EMAIL=seba@agenciazeta.com
