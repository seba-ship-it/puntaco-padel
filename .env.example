# Copiá este archivo a ".env" y completá con los datos de tu proyecto de
# Supabase (Settings → API en el dashboard). La "anon key" es pública por
# diseño de Supabase — no es un secreto — pero igual no se sube a GitHub
# directamente: en producción se cargan como "secrets" en GitHub Actions.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Email fijo del usuario compartido de Supabase Auth (ver supabase/schema.sql).
# Si no lo cambiás, dejalo así y creá el usuario con este mismo email.
VITE_ADMIN_EMAIL=encargado@puntaco.local
